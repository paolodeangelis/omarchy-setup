#!/usr/bin/env python3
"""Terminate stale WinApps RemoteApp marker sessions, and nothing else."""

from __future__ import annotations

import argparse
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path


MARKER_TITLE = "RemoteApp Marker Window"
FREERDP_NAMES = {"xfreerdp", "xfreerdp3"}


def read_text(path: Path) -> str | None:
    try:
        return path.read_text().strip()
    except (OSError, UnicodeError):
        return None


def descendants(proc_root: Path, root_pid: int) -> set[int]:
    parents: dict[int, int] = {}
    for process in proc_root.iterdir():
        if not process.name.isdigit():
            continue
        status = read_text(process / "status")
        if status is None:
            continue
        for line in status.splitlines():
            if line.startswith("PPid:"):
                value = line.partition(":")[2].strip()
                if value.isdigit():
                    parents[int(process.name)] = int(value)
                break

    found: set[int] = set()
    changed = True
    while changed:
        changed = False
        for pid, parent in parents.items():
            if pid not in found and (parent == root_pid or parent in found):
                found.add(pid)
                changed = True
    return found


def tracked_roots(data_root: Path) -> set[int]:
    roots: set[int] = set()
    for path in data_root.glob("FreeRDP_Process_*.cproc"):
        value = path.name.removeprefix("FreeRDP_Process_").removesuffix(".cproc")
        if value.isdigit():
            roots.add(int(value))
    return roots


def freerdp_candidates(proc_root: Path, roots: set[int]) -> set[int]:
    candidates: set[int] = set()
    for root in roots:
        for pid in {root, *descendants(proc_root, root)}:
            if read_text(proc_root / str(pid) / "comm") in FREERDP_NAMES:
                candidates.add(pid)
    return candidates


def hyprland_clients() -> list[dict[str, object]]:
    result = subprocess.run(
        ("hyprctl", "clients", "-j"),
        check=True,
        text=True,
        capture_output=True,
    )
    clients = json.loads(result.stdout)
    if not isinstance(clients, list):
        raise ValueError("hyprctl returned an unexpected clients document")
    return [client for client in clients if isinstance(client, dict)]


def is_marker(client: dict[str, object]) -> bool:
    title = client.get("title")
    if title == MARKER_TITLE:
        return True
    size = client.get("size")
    return (
        title == ""
        and isinstance(size, list)
        and len(size) == 2
        and all(isinstance(value, int) and 0 < value <= 16 for value in size)
    )


def marker_only_pids(candidates: set[int], clients: list[dict[str, object]]) -> set[int]:
    windows: dict[int, list[dict[str, object]]] = {}
    for client in clients:
        pid = client.get("pid")
        if isinstance(pid, int):
            windows.setdefault(pid, []).append(client)

    return {
        pid
        for pid in candidates
        if windows.get(pid)
        and all(is_marker(client) for client in windows[pid])
    }


def terminate(pid: int, proc_root: Path) -> bool:
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return True
    except PermissionError:
        return False

    for _ in range(50):
        status = read_text(proc_root / str(pid) / "status")
        if status is None or "\nState:\tZ" in f"\n{status}":
            return True
        time.sleep(0.1)
    return False


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Close stale WinApps sessions that show only a RemoteApp marker."
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="show matching sessions without closing them"
    )
    args = parser.parse_args(argv)

    proc_root = Path("/proc")
    data_root = Path(
        os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local" / "share"))
    ) / "winapps"

    roots = tracked_roots(data_root)
    if not roots:
        print("No tracked WinApps RemoteApp sessions found.")
        return 0

    try:
        clients = hyprland_clients()
    except (FileNotFoundError, subprocess.CalledProcessError, json.JSONDecodeError, ValueError) as error:
        print(f"Cannot verify Hyprland windows; no process was changed: {error}", file=sys.stderr)
        return 2

    candidates = marker_only_pids(freerdp_candidates(proc_root, roots), clients)
    if not candidates:
        print("No marker-only WinApps session found; no process was changed.")
        return 0

    if args.dry_run:
        print("Would close stale WinApps FreeRDP process(es): " + ", ".join(map(str, sorted(candidates))))
        return 0

    failed = [pid for pid in sorted(candidates) if not terminate(pid, proc_root)]
    if failed:
        print(
            "Could not close WinApps FreeRDP process(es): " + ", ".join(map(str, failed)),
            file=sys.stderr,
        )
        return 1

    print("Closed stale WinApps marker session(s): " + ", ".join(map(str, sorted(candidates))))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
